    }
  ],
  "narrative": {
    "northStar": "Operational clarity",
    "overview": "This is a source-first record of the implemented Persian RTL interface, preserving the purple Hozoryar identity. “Operational clarity” is a descriptive shorthand for the built direction, not a newly approved metaphor or a fabricated workshop result. The public website is editorial and spacious; the administration panel is denser, with light operational neutrals and explicit light/dark/system choice.\n\nPRODUCT.md and branding/BRAND.md remain product and identity authorities. This document records implementation, including differences from older branding recommendations; it does not replace those sources or the generated legacy design-system MASTER. Source precedence for the panel is style.css → nav.css → panel.css → theme.css → product.css. Website home.css imports product.css, then defines its own site tokens.",
    "keyCharacteristics": [
      "Persian RTL reading and navigation with self-hosted web Vazirmatn.",
      "Purple identity, restrained operational surfaces, explicit theme choice.",
      "Separate website and panel palettes; local overrides remain contextual."
    ],
    "rules": [
      {
        "name": "The Surface Context Rule",
        "body": "Resolve colors against the actual website or panel cascade and active theme before extending a screen.",
        "section": "colors"
      },
      {
        "name": "The Flat Operations Rule",
        "body": "Keep administrative cards flat and use borders and theme surfaces for their hierarchy.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the Persian product name, RTL layout and approved purple identity.",
      "Do choose tokens from the target surface and active theme, reading the complete stylesheet cascade.",
      "Do keep visible keyboard focus, meaningful status colors and independent table scrolling.",
      "Do describe real capabilities and state limitations plainly."
    ],
    "donts": [
      "Don't invent customer counts, prices, operational statistics or release approval.",
      "Don't treat legacy gradients, eyebrow styles or conflicting radius variables as new defaults.",
      "Don't claim Android visual approval or self-hosted native Vazirmatn from web font declarations.",
      "Don't replace or alter the approved original logo files to conceal their decoding defect."
    ]
  }
}
