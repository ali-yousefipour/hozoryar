  "components": [
    {
      "name": "Website primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Website CTA; fixed saturated purple in both themes.",
      "html": "<a class=\"ds-site-button\" href=\"#\">ورود به حضوریار</a>",
      "css": ".ds-site-button{display:inline-flex;align-items:center;justify-content:center;background:#6d28d9;color:#fff;text-decoration:none;border-radius:8px;padding:11px 22px;font:600 14px Vazirmatn,Tahoma,sans-serif;min-height:46px}.ds-site-button:hover{background:#5420a8}.ds-site-button:focus-visible{outline:3px solid var(--site-accent,#6d28d9);outline-offset:5px}"
    },
    {
      "name": "Panel primary button",
      "kind": "button",
      "refersTo": "panel-button-primary",
      "description": "Panel action inherits active theme custom properties.",
      "html": "<button class=\"ds-primary\">ذخیره</button>",
      "css": ".ds-primary{background:var(--hz-primary,#6d28d9);color:white;border:0;border-radius:8px;padding:12px 20px;min-height:46px;font:750 16px Vazirmatn,Tahoma,sans-serif;cursor:pointer}.ds-primary:hover{background:var(--hz-primary-dark,#5b21b6)}.ds-primary:focus-visible{outline:3px solid #a78bfa;outline-offset:3px}"
    },
    {
      "name": "Panel text field",
      "kind": "input",
      "refersTo": "panel-input",
      "description": "Light-mode field sample; dark source uses a darker field fill and stroke.",
      "html": "<label class=\"ds-label\" dir=\"rtl\">نام کاربری<input class=\"ds-input\" placeholder=\"نام کاربری\"></label>",
      "css": ".ds-label{display:grid;gap:7px;font:650 13px Vazirmatn,Tahoma,sans-serif;color:var(--hz-text,#282238)}.ds-input{font:400 16px Vazirmatn,Tahoma,sans-serif;padding:11px 14px;min-height:46px;background:var(--hz-surface,#fff);color:var(--hz-text,#282238);border:1px solid #b9b5c7;border-radius:8px}.ds-input:focus{border-color:#8b5cf6}.ds-input:focus-visible{outline:3px solid #a78bfa;outline-offset:3px}"
    },
    {
      "name": "Panel card",
      "kind": "card",
      "refersTo": "panel-card",
      "description": "Flat operational container; no interaction states for a static section.",
      "html": "<section class=\"ds-card\" dir=\"rtl\"><h2>درخواست‌ها</h2><p>وضعیت درخواست‌های شرکت</p></section>",
      "css": ".ds-card{background:var(--hz-surface,#fff);color:var(--hz-text,#282238);border:1px solid var(--panel-border,#dddfe9);border-radius:12px;padding:22px;box-shadow:none;font-family:Vazirmatn,Tahoma,sans-serif}.ds-card h2{font-size:17px}.ds-card p{color:var(--panel-muted,#686579);font-size:13px}"
    },
    {
      "name": "Panel navigation",
      "kind": "nav",
      "description": "Light-mode navigation state sample; dark states are context-specific.",
      "html": "<nav class=\"ds-nav\" dir=\"rtl\" aria-label=\"منوی اصلی\"><button class=\"ds-active\" aria-current=\"page\">داشبورد</button><button>پرسنل</button></nav>",
      "css": ".ds-nav{display:grid;gap:4px;font-family:Vazirmatn,Tahoma,sans-serif}.ds-nav button{font:400 16px Vazirmatn,Tahoma,sans-serif;background:transparent;text-align:right;color:var(--hz-text,#534b66);border:0;border-radius:8px;padding:10px 14px;min-height:48px;transition:background .18s,color .18s}.ds-nav button:hover{background:#f5f3ff}.ds-nav .ds-active{background:#ede9fe;color:#5b21b6}.ds-nav button:focus-visible{outline:3px solid #a78bfa;outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-nav button{transition:none}}"
    },
    {
