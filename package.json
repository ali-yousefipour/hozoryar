{
  "name": "hozoryar",
  "version": "0.16.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "php -S 127.0.0.1:3000 -t php/app php/app/index.php",
    "start:reference": "node server/index.js",
    "bootstrap": "php php/cli/bootstrap-company.php",
    "bootstrap:reference": "node server/bootstrap.js",
    "migrate": "php php/cli/migrate.php",
    "platform-admin": "php php/cli/bootstrap-platform-admin.php",
    "platform-admin:reference": "node server/platform-admin.js",
    "backup": "php php/cli/database-backup.php create",
    "verify-backup": "php php/cli/database-backup.php verify",
    "restore-backup": "php php/cli/database-backup.php restore",
    "backup:reference": "node server/backup.js",
    "verify-backup:reference": "node server/verify-backup.js",
    "restore-backup:reference": "node server/restore-backup.js",
    "test": "node --test tests/*.test.js tests/*.test.mjs"
  },
  "engines": { "node": ">=22.13.0" }
}
