{
  "name": "hozoryar/attendance",
  "description": "Multi-tenant attendance administration for Linux shared hosting",
  "type": "project",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-intl": "*",
    "ext-curl": "*",
    "ext-zip": "*"
  },
  "scripts": {
    "start": "php -S 127.0.0.1:3000 -t php/app php/app/index.php",
    "migrate": "php php/cli/migrate.php",
    "package": "php php/cli/package-shared-host.php",
    "backup": "php php/cli/database-backup.php create",
    "verify-backup": "php php/cli/database-backup.php verify",
    "restore-backup": "php php/cli/database-backup.php restore"
  }
}
